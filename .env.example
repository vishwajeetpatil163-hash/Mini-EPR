# ==========================================
# Wholesale ERP + CRM Operations Portal Configuration
# ==========================================

# Port where Express server runs (Cloud Run default: 3000)
PORT=3000

# Secret key for JWT signing & verification
JWT_SECRET="wholesale-erp-secret-key-2026-production"

# Database connection URL for PostgreSQL / Prisma (if external DB connected)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wholesale_erp?schema=public"

# Environment: 'development' or 'production'
NODE_ENV="development"
